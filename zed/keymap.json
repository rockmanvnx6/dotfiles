// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-b": "workspace::ToggleRightDock",
      "ctrl-shift-b": "workspace::ToggleLeftDock",
      "alt-s alt-z": "workspace::ToggleZoom",
      "ctrl-v": "editor::Paste",
      "ctrl-c": "editor::Copy",
      "ctrl-f": "buffer_search::Deploy",
      "ctrl-a": "editor::SelectAll",
      "ctrl-s": "workspace::Save",
      "ctrl-alt-l": "editor::ToggleLineNumbers",
      "ctrl-k ctrl-w": "pane::CloseAllItems",
      "ctrl-alt-f": "pane::DeploySearch",
      "ctrl-shift-f": "text_finder::Toggle"
    },
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-alt-f": "pane::DeploySearch",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "ctrl-f": "buffer_search::Deploy",
      "ctrl-`": "workspace::ToggleBottomDock",
      "space s g": "text_finder::Toggle",
      "g r r": "editor::FindAllReferences",
      "g r i": "editor::GoToImplementation",
      "g r d": "editor::GoToDefinition",
      "g r t": "editor::GoToTypeDefinition",
      "g r shift-d": "editor::GoToDeclaration",
      "g r n": "editor::Rename",
      "g r a": "editor::ToggleCodeActions",
      "space p": "editor::Format",
      "space space": "file_finder::Toggle",
      "space v": "pane::SplitVertical",
      "space w": "pane::CloseActiveItem",
      "space h": "pane::SplitHorizontal",
      "space l": "workspace::ActivatePreviousPane",
      "space e": "project_panel::ToggleFocus",
      "space g g": [
        "task::Spawn",
        {
          "task_name": "start lazygit",
          "reveal_target": "center"
        }
      ],
      "space g f": [
        "task::Spawn",
        {
          "task_name": "start lazygit file log",
          "reveal_target": "center"
        }
      ],
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
      "alt-h": "vim::Left",
      "alt-l": "vim::Right",
      "alt-j": "vim::Down",
      "alt-k": "vim::Up",
    },
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-shift-b": "workspace::ToggleLeftDock",
      "space e": "project_panel::ToggleFocus",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-/": "workspace::ToggleBottomDock",
      "alt-s alt-z": "workspace::ToggleZoom",
    },
  },
  {
    "context": "Dock",

    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-b": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-b": null,
    },
  },
  {
    "context": "Workspace && !Editor && !Terminal",
    "bindings": {
      "space s g": "text_finder::Toggle",
      "ctrl-alt-f": "pane::DeploySearch",
      "ctrl-shift-f": "text_finder::Toggle",
    },
  },
  {
    "context": "TabSwitcher",
    "bindings": {
      "ctrl-k": "menu::SelectPrevious",
      "ctrl-j": "menu::SelectNext",
      "ctrl-w": "tab_switcher::CloseSelectedItem",
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "alt-w": "pane::CloseActiveItem",
      "ctrl-w": null,
      "ctrl-shift-t": [
        "pane::CloseOtherItems",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-alt-t": null
    }
  }
]
